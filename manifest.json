{
  "manifest_version": 2,
  "name": "YT Bilingual Translator",
  "version": "0.61.0",
  "description": "Bilingual subtitles for YouTube and Twitch Live with sentence-level translation, DeepL/Azure keys and local translation.",
  "icons": {
    "48": "icons/brand-cc-48.png",
    "96": "icons/brand-cc-96.png",
    "128": "icons/brand-cc-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://translation.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://libretranslate.com/*",
    "https://*.libretranslate.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://*.lingva.ml/*",
    "https://*.run.app/*",
    "https://*.cloudfunctions.net/*",
    "https://*.wikipedia.org/*",
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "optional_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://firefox.settings.services.mozilla.com/*",
    "https://firefox-settings-attachments.cdn.mozilla.net/*"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "lang-codes.js",
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "i18n.js",
        "twitch-content.js"
      ],
      "css": [
        "twitch-content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "YT Bilingual Translator",
    "default_icon": {
      "48": "icons/brand-cc-48.png",
      "96": "icons/brand-cc-96.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "popup/popup.html",
    "browser_style": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-bilingual-subtitle-translator@github-ErttyOuO",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "lang-codes.js",
      "bergamot-engine.js",
      "background.js"
    ],
    "persistent": false
  },
  "web_accessible_resources": [
    "page-bridge.js",
    "icons/brand-cc-48.png"
  ],
  "homepage_url": "https://github.com/ErttyOuO/YT-bilingual-translator"
}
